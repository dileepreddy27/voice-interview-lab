FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -o /gateway ./cmd/gateway
FROM alpine:3.22
RUN apk add --no-cache ca-certificates && adduser -D app
WORKDIR /app
COPY --from=build /gateway /app/gateway
COPY web /app/web
USER app
ENV GATEWAY_ADDR=0.0.0.0:8080
EXPOSE 8080
CMD ["/app/gateway"]
